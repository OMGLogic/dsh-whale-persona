{
  "name": "dsh-whale-persona",
  "version": "0.2.0",
  "description": "DeepSeek 鲸鱼娘全局人设插件：默认开启鲸鱼娘人设，对话输入栏模型选择器旁提供开关，关闭时恢复默认人设。适配 DeepSeek Harness 0.2.0-rc.2。",
  "type": "module",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMGLogic/dsh-whale-persona.git"
  },
  "homepage": "https://github.com/OMGLogic/dsh-whale-persona#readme",
  "bugs": {
    "url": "https://github.com/OMGLogic/dsh-whale-persona/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "persona",
    "whale"
  ],
  "license": "MIT"
}
